# ============================================================================
# eCommerce Starter Kit — единая конфигурация окружения
# ----------------------------------------------------------------------------
# Все credentials и параметры окружения проекта хранятся ТОЛЬКО в этом файле
# (в корне репозитория, рядом с docker-compose.yml).
#
# Быстрый старт:
#   cp .env.example .env
#   make init
#
# Секреты, помеченные [auto], генерируются автоматически при `make init`
# (openssl rand). Уже существующие значения никогда не перезаписываются.
# MEDUSA_PUBLISHABLE_KEY создается seed-скриптом и дописывается в .env
# автоматически.
#
# НЕ КОММИТЬТЕ .env В GIT (файл добавлен в .gitignore).
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
# Режим окружения. Docker Compose запускает dev-серверы (hot reload).
NODE_ENV=development

# Название магазина: показывается в админке Medusa и на витрине.
STORE_NAME="Demo Store"

# Локаль и валюта магазина по умолчанию (ISO-коды).
# Локаль влияет на форматирование цен на витрине (Intl.NumberFormat).
STORE_LOCALE=ru-RU
STORE_CURRENCY=rub

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# POSTGRES_HOST и POSTGRES_PORT — адреса ВНУТРИ Docker-сети,
# поэтому PostgreSQL не нужен на хост-машине.
# База данных и пользователь создаются автоматически при первом запуске
# контейнера postgres (стандартный механизм официального образа).
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=medusa
POSTGRES_USER=medusa
# [auto] Пароль пользователя PostgreSQL (hex, генерируется при make init).
POSTGRES_PASSWORD=

# ── Redis ───────────────────────────────────────────────────────────────────
# URL Redis внутри Docker-сети. Используется Medusa для сессий, кэша,
# шины событий и движка workflows.
REDIS_URL=redis://redis:6379

# ── Medusa ──────────────────────────────────────────────────────────────────
# Порт, на котором Medusa слушает API, Admin и /health (внутри и снаружи).
MEDUSA_PORT=9000

# Внутренний URL Medusa внутри Docker-сети — его использует серверная
# сторона Nuxt (SSR). Не раскрывается браузеру.
MEDUSA_INTERNAL_URL=http://medusa:9000

# Публичный URL Medusa для доступа с хост-машины.
MEDUSA_PUBLIC_URL=http://localhost:9000

# Publishable API key для Store API. НЕ секрет (передается в браузер
# по определению). Создается seed-скриптом автоматически; вручную заполнять
# не нужно.
MEDUSA_PUBLISHABLE_KEY=

# [auto] Секреты Medusa (hex, генерируются при make init).
JWT_SECRET=
COOKIE_SECRET=

# Разрешенные CORS origins (список через запятую, без слэша в конце).
# Store API — origin витрины; Admin API и /auth — origins админки
# (9000 — Medusa Admin в прод-режиме, 5173 — dev-сервер админки).
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000,http://localhost:5173

# ── Administrator ───────────────────────────────────────────────────────────
# Учетная запись администратора Medusa Admin. Создается один раз
# при инициализации; при повторных запусках не пересоздается.
ADMIN_EMAIL=admin@example.com
# [auto] Пароль администратора (генерируется при make init; минимум 8 символов).
ADMIN_PASSWORD=

# ── Nuxt ───────────────────────────────────────────────────────────────────
# Порт storefront (внутри и снаружи Docker).
NUXT_PORT=3000

# Публичный URL витрины (используется для SEO/ссылок).
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Таймаут запросов витрины к Medusa Store API в миллисекундах
# (Commerce Client). По умолчанию 15000; раскомментируйте, чтобы изменить.
# NUXT_PUBLIC_MEDUSA_TIMEOUT_MS=15000

# ── Meilisearch ─────────────────────────────────────────────────────────────
# Внутренний URL Meilisearch внутри Docker-сети (наружу не публикуется).
MEILISEARCH_HOST=http://meilisearch:7700

# [auto] Master key Meilisearch (минимум 16 символов, генерируется при make init).
MEILISEARCH_MASTER_KEY=

# Префикс имен поисковых индексов (зарезервирован для этапа поиска).
MEILISEARCH_INDEX_PREFIX=store

# Стоп-слова полнотекстового поиска: JSON-массив строк. Необязательно;
# по умолчанию (пусто) применяется встроенный набор ["и","в","с","для","на"].
# Пример: MEILISEARCH_STOP_WORDS=["и","в","с","для","на","the","a"]
# Некорректный JSON не роняет backend: применяются значения по умолчанию,
# в логах Medusa — предупреждение. Применяется при создании/миграции
# поискового индекса (make search-init / make search-reindex).
# MEILISEARCH_STOP_WORDS=

# Синонимы полнотекстового поиска: JSON-объект "слово": ["синонимы"]
# (двунаправленные синонимы Meilisearch). Необязательно; по умолчанию — пусто.
# Пример: MEILISEARCH_SYNONYMS={"худи":["толстовка","свитшот"]}
# Формат и способ применения — как у стоп-слов (см. docs/search.md).
# MEILISEARCH_SYNONYMS=

# Расписание scheduled job сверки поискового индекса с PostgreSQL (cron):
# сверка обнаруживает отсутствующие/устаревшие/лишние документы и
# точечно ремонтирует только затронутые товары (без полной переиндексации).
# Формат — cron-выражение; по умолчанию (пусто/комментарий) — раз в час.
# Ручной запуск той же сверки: make search-reconcile.
# SEARCH_RECONCILE_CRON=0 * * * *

# ── Email-уведомления (этап 5.2.3) ──────────────────────────────────
# Штатный Notification Module Medusa + провайдер notification-smtp.
# Доставка одноразовых токенов: сброс пароля, подтверждение переноса
# заказа. См. docs/notifications.md.

# Выключить все email-уведомления (подписчики и job повторной доставки).
# NOTIFICATION_ENABLED=true

# Mailpit — локальный SMTP-ящик для разработки и тестов (принимает письма
# без аутентификации). false = сервис не запускается (production).
# WEB UI: http://localhost:8025 (только loopback хоста). Проверка здоровья:
# GET /api/v1/messages (у Mailpit нет отдельного /ready-маршрута).
MAILPIT_ENABLED=true
# Порт Web UI Mailpit на хосте (только 127.0.0.1).
# MAILPIT_UI_PORT=8025

# SMTP-сервер провайдера. Для локальной разработки — Mailpit:
# хост внутри Docker-сети, порт 1025, без SSL и пароля.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Отправитель писем. Для production укажите реальный SMTP-сервер и адрес
# на вашем домене; SMTP_FROM_NAME по умолчанию — STORE_NAME.
SMTP_FROM_EMAIL=no-reply@localhost
# SMTP_FROM_NAME=Demo Store

# Расписание job-а повторной доставки неудачных писем (cron; по умолчанию
# раз в 5 минут) и окно повторов в минутах (по умолчанию 15 ≈ TTL
# reset-токена; за пределами окна письма не рассылаются).
# NOTIFICATION_RETRY_CRON=*/5 * * * *
# NOTIFICATION_RETRY_WINDOW_MINUTES=15

# ── Платежи (этап 6.2) ───────────────────────────────────────────────────────
# Способы оплаты: pp_cod_cash (оплата при получении — доступен везде) и
# pp_demo_online (тестовая фиктивная онлайн-оплата — только development/
# test, в production не регистрируется и блокируется провайдером и guard-ом).
# Секрет HMAC webhook-а демо-провайдера (POST /hooks/payment/pp_demo_online,
# заголовок x-demo-signature): генерируется автоматически, используется
# ТОЛЬКО на backend, в production не нужен. См. docs/payments.md.
PAYMENT_DEMO_WEBHOOK_SECRET=

# ── Rate limiting маршрутов аутентификации (этап 5.2.2) ─────────────────────
# Формат значения: "<max>/<window_seconds>" — максимум попыток за окно.
# Счетчики распределены (Redis через Cache Module), окно скользящее
# (TTL обновляется при каждой попытке). Лимит по IP — анти-burst,
# по идентификатору (нормализованный email, HMAC-хеш в ключах) —
# антибрутфорс. Превышение: HTTP 429 + Retry-After. При недоступности
# Redis лимит пропускается (fail-open). Детали — docs/configuration.md.
# Вход покупателя (POST /auth/customer/emailpass):
# AUTH_RATE_LIMIT_LOGIN_IP=30/60
# AUTH_RATE_LIMIT_LOGIN_ID=5/900
# Регистрация (POST /auth/customer/emailpass/register):
# AUTH_RATE_LIMIT_REGISTER_IP=30/60
# AUTH_RATE_LIMIT_REGISTER_ID=5/3600
# Запрос сброса пароля (POST /auth/customer/emailpass/reset-password):
# AUTH_RATE_LIMIT_RESET_IP=30/60
# AUTH_RATE_LIMIT_RESET_ID=3/3600
# Смена пароля по reset-токену (POST /auth/customer/emailpass/update,
# только по IP — токен непрозрачен):
# AUTH_RATE_LIMIT_UPDATE_IP=30/60
# Запрос переноса заказа (POST /store/orders/:id/transfer/request,
# идентификатор — авторизованный покупатель):
# AUTH_RATE_LIMIT_TRANSFER_IP=30/60
# AUTH_RATE_LIMIT_TRANSFER_ID=10/3600
# Доверять X-Forwarded-For (включать ТОЛЬКО за reverse proxy, который
# ПЕРЕЗАПИСЫВАЕТ заголовок; по умолчанию IP берется из TCP-сокета —
# заголовок не подделать). Этап 10 (production за прокси).
# AUTH_RATE_LIMIT_TRUST_PROXY=false

# ── Initialization ─────────────────────────────────────────────────────────
# true — seed-скрипт дополнительно создаст демо-каталог:
# 3 категории, 10 товаров с вариантами, ценами (RUB) и остатками,
# включая товары без наличия.
SEED_DEMO_DATA=true
